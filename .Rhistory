API_KEY <- Sys.getenv("16d6398b64103b3f43e18a01e19687599033467033379ef849cb3d831a5f748a")
library(httr2)
library(jsonlite)
library(dplyr)
library(purrr)
library(tidyr)
library(stringr)
rate_limit_remaining <- Inf
rate_limit_reset <- Sys.time()
rate_limit_remaining <- Inf
rate_limit_reset <- Sys.time()
safe_get_openaq <- function(url) {
# -------------------------------------------------------
# If no requests remaining, wait until reset
# -------------------------------------------------------
if(rate_limit_remaining <= 1) {
wait_time <- as.numeric(
difftime(rate_limit_reset,
Sys.time(),
units = "secs")
)
if(wait_time > 0) {
message(
"Rate limit reached. Waiting ",
round(wait_time),
" seconds..."
)
Sys.sleep(wait_time + 1)
}
}
# -------------------------------------------------------
# Perform request
# -------------------------------------------------------
resp <- request(url) %>%
req_headers(
"X-API-Key" = API_KEY
) %>%
req_perform()
# -------------------------------------------------------
# Read rate limit headers
# -------------------------------------------------------
headers <- resp_headers(resp)
rate_limit_remaining <<- as.numeric(
headers[["x-ratelimit-remaining"]]
)
reset_seconds <- as.numeric(
headers[["x-ratelimit-reset"]]
)
if(!is.na(reset_seconds)) {
rate_limit_reset <<- Sys.time() + reset_seconds
}
message(
"Requests remaining: ",
rate_limit_remaining
)
# -------------------------------------------------------
# Parse JSON
# -------------------------------------------------------
resp_body_json(
resp,
simplifyVector = TRUE
)
}
get_all_pages <- function(base_url,
limit = 1000,
max_pages = 1000) {
results_all <- list()
for(page in 1:max_pages) {
url <- paste0(
base_url,
"?limit=",
limit,
"&page=",
page
)
message("Fetching page: ", page)
res <- safe_get_openaq(url)
if(length(res$results) == 0) {
message("No more results.")
break
}
results_all[[page]] <- res$results
}
bind_rows(results_all)
}
locations <- get_all_pages(
"https://api.openaq.org/v3/locations"
)
