"openaq",
"airgradient",
"sensor.community",
"luftdaten",
"clarity",
"purpleair"
)
partner_keywords <- c(
"openaq",
"airgradient",
"sensor.community",
"luftdaten",
"clarity",
"purpleair"
)
pattern <- paste(
partner_keywords,
collapse = "|"
)
locations_partner <- locations %>%
mutate(
combined = paste(
owner$name,
providers$name,
name,
sep = " "
) %>%
tolower()
) %>%
filter(
str_detect(combined, pattern)
)
location_ids <- unique(
locations_partner$id
)
get_location_sensors <- function(location_id) {
url <- paste0(
"https://api.openaq.org/v3/locations/",
location_id,
"/sensors"
)
tryCatch({
res <- safe_get_openaq(url)
if(length(res$results) == 0) {
return(NULL)
}
as_tibble(res$results) %>%
mutate(
location_id = location_id
)
}, error = function(e) {
message(
"Failed location: ",
location_id
)
return(NULL)
})
}
sensors_all <- map_dfr(
location_ids,
get_location_sensors
)
sensors_all
sensors_all
